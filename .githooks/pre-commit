#!/usr/bin/env bash
set -e

# Pre-commit hook: run repository linters and (optionally) builds
echo "Running pre-commit checks: lint..."

# Block commits on protected branches
branch=$(git rev-parse --abbrev-ref HEAD 2> /dev/null || true)
if [ "$branch" = "develop" ]; then
  echo "ERROR: Direct commits to 'develop' are blocked. Create a feature branch and open a PR." >&2
  exit 1
fi

# Prefer npm run lint at root
if command -v npm > /dev/null 2>&1; then
  npm run lint
else
  echo "npm not found; skipping lint"
fi

echo "Pre-commit checks passed"

exit 0
