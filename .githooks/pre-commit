#!/usr/bin/env bash
set -e

echo "Running pre-commit checks: lint..."

# Block commits on protected branches
branch=$(git rev-parse --abbrev-ref HEAD 2> /dev/null || true)
if [ "$branch" = "develop" ]; then
  echo "ERROR: Direct commits to 'develop' are blocked. Create a feature branch and open a PR." >&2
  exit 1
fi

# Collect staged files (added, copied, modified, renamed — excluding deleted)
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged" ]; then
  echo "No staged changes; skipping lint"
  echo "Pre-commit checks passed"
  exit 0
fi

# Filter by extension
js_ts=$(echo "$staged" | grep -E '\.(js|ts|tsx|cjs|mjs)$' || true)
md=$(echo "$staged" | grep -E '\.md$' || true)
styles=$(echo "$staged" | grep -E '\.(scss|css)$' || true)

if [ -n "$js_ts" ]; then
  echo "ESLint..."
  echo "$js_ts" | xargs npx eslint --max-warnings=0 --no-error-on-unmatched-pattern --no-warn-ignored
fi

if [ -n "$md" ]; then
  echo "Markdownlint..."
  echo "$md" | xargs npx markdownlint-cli --config .markdownlint.json
fi

if [ -n "$styles" ]; then
  echo "Stylelint..."
  echo "$styles" | xargs npx stylelint
fi

echo "Prettier..."
echo "$staged" | xargs npx prettier --check --ignore-unknown

echo "Pre-commit checks passed"
exit 0
