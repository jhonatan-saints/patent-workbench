# ──────────────────────────────────────────────
# Patent Workbench — Client environment variables
# Copy to .env and fill in values as needed.
# ──────────────────────────────────────────────

# Base URL of the backend API (default: http://localhost:3001).
VITE_API_BASE=http://localhost:3001

# API key sent with every request to the server (must match server API_KEY if set).
# This value is embedded in the client bundle — only set it for local/trusted deployments.
VITE_API_KEY=

# LLM request timeout in ms (default: 300000 = 5 min). Should match server LLM_TIMEOUT_MS.
VITE_LLM_TIMEOUT_MS=300000

# Default LLM model. Should match server DEFAULT_MODEL.
VITE_DEFAULT_MODEL=qwen2.5:7b

# Number of options generated per workflow step (1–5). Should match server default num_options.
VITE_NUM_OPTIONS=3
