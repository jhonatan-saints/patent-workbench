{
  "name": "patent-workbench-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo root for Patent Workbench (client + server)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "bootstrap": "npm run install-all",
    "clean": "bash ./scripts/clean.sh",
    "client": "npm --workspace client run dev",
    "client:build": "npm --workspace client run build",
    "client:install": "npm --prefix client install",
    "server": "npm --workspace server run start",
    "server:dev": "npm --workspace server run dev",
    "server:install": "npm --prefix server install",
    "setup": "bash ./scripts/setup.sh",
    "lint": "npm run lint:eslint && npm run lint:markdown && npm run lint:style",
    "lint:eslint": "npx eslint --max-warnings=0 --no-error-on-unmatched-pattern .",
    "lint:markdown": "npx markdownlint-cli -i \"**/node_modules/**\" --config .markdownlint.json ./*.md ./**/*.md ./**/**/*.md ./**/**/**/*.md ./**/**/**/**/*.md",
    "lint:style": "npx stylelint **/*.scss **/*.css",
    "start": "concurrently \"npm run server:dev\" \"npm run client\""
  },
  "prepare": "git config core.hooksPath .githooks || true",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.0.1",
    "stylelint": "^17.5.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0"
  }
}
