{
  "name": "patent-workbench-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo root for Patent Workbench (client + server)",
  "workspaces": ["client", "server"],
  "scripts": {
    "bootstrap": "npm run install-all",
    "clean": "bash ./scripts/clean.sh",
    "client": "npm --workspace client run dev",
    "client:build": "npm --workspace client run build",
    "client:install": "npm --prefix client install",
    "server": "npm --workspace server run start",
    "server:dev": "npm --workspace server run dev",
    "server:install": "npm --prefix server install",
    "setup": "bash ./scripts/setup.sh",
    "start": "concurrently \"npm run server:dev\" \"npm run client\""
  },
  "engines": {
    "node": ">=16"
  }
}
