# ──────────────────────────────────────────────
# Patent Workbench — Server environment variables
# Copy to .env and fill in values as needed.
# ──────────────────────────────────────────────

# Server port (default: 3001)
PORT=3001

# Host binding.
# Default: 127.0.0.1 (loopback only — recommended).
# Set to 0.0.0.0 only behind a firewall or reverse proxy.
HOST=127.0.0.1

# Allowed CORS origin for the browser client (default: http://localhost:5173).
# REQUIRED in production — startup will throw if unset.
CORS_ORIGIN=http://localhost:5173

# Node environment: development | production
NODE_ENV=development

## Security

# Optional shared API key.
# When set, every request must include: x-api-key: <value>
# Leave empty to disable API key enforcement (local dev only).
API_KEY=

# Set to "true" if the server runs behind a trusted reverse proxy
# that sets the X-Forwarded-For header (nginx, Caddy, etc.).
# Leave empty or "false" otherwise — enabling this when not behind a proxy
# allows clients to spoof their IP and bypass rate limiting.
TRUST_PROXY=false

## Limits

# Maximum prompt length in characters (default: 16000)
PROMPT_MAX_LENGTH=16000

# Maximum request body size (default: 512kb)
BODY_LIMIT=512kb

## Rate limiting

# Global rate limit window in ms (default: 900000 = 15 min)
RATE_WINDOW_MS=900000

# Global rate limit max requests per window (default: 100)
RATE_MAX=100

# /generate endpoint rate limit window in ms (default: 60000 = 1 min)
GENERATE_RATE_WINDOW_MS=60000

# /generate endpoint max requests per window (default: 20)
GENERATE_RATE_MAX=20

## LLM

# Ollama base URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default Ollama model when none is specified by the client
# Recommended models (run "ollama pull <model>" before use):
#   mistral      — 7B, ~4GB,  good baseline
#   qwen2.5:7b   — 7B, ~4.7GB, better reasoning and structured text (recommended)
#   phi3:mini    — 3.8B, ~2.3GB, fastest option for low-end hardware
#   phi4         — 14B, ~9GB, best quality, requires 16GB+ RAM
DEFAULT_MODEL=qwen2.5:7b

# LLM request timeout in ms (default: 120000 = 2 min)
LLM_TIMEOUT_MS=120000

## Logging

# Log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

## Server lifecycle

# Graceful shutdown timeout in ms (default: 30000 = 30 s)
SHUTDOWN_TIMEOUT_MS=30000
